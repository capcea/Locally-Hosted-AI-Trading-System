# Copy using `make bootstrap`; credentials below MUST be generated, never reused.
# The bootstrap writes local development secrets to ignored .env, without printing them.
APP_ENVIRONMENT=development
BROKER_ENVIRONMENT=SIMULATED
LIVE_TRADING_ENABLED=false
WORKER_EXECUTION_ENABLED=false
EXECUTOR_CAPABILITY=DENY_ALL
DATABASE_URL=postgresql+psycopg://research:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:15432/research
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
REDIS_URL=redis://127.0.0.1:16379/0
OBJECT_STORE_URL=http://127.0.0.1:19000
MINIO_ROOT_USER=REPLACE_WITH_GENERATED_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
# AI gateway and broker secrets are intentionally absent from the control plane.
# Run `make identity-setup` after bootstrap. It generates stable private Phase 1 keys,
# rewrites DATABASE_URL for research_app, and adds the migration-only admin DSN:
# MIGRATION_DATABASE_URL, AUTH_DATABASE_PASSWORD, AUTH_ENCRYPTION_KEY, AUTH_BOOTSTRAP_TOKEN.
# Never copy key values into this file or rotate AUTH_ENCRYPTION_KEY without a migration:
# it protects MFA secrets, recovery hashes, CSRF derivation and audit integrity.
# AUTH_COOKIE_SECURE defaults to true. The setup explicitly uses false for local HTTP only.
# AUTH_ORIGINS defaults to the exact local frontend origins (port 5173).
# `make market-setup` generates stable MARKET_STORAGE_USER/PASSWORD locally.
# MinIO root credentials are used only by the migration-time provisioner; API/data worker receive
# a scoped identity with pinned-version read/write and no delete/admin privileges.
# MARKET_RETENTION_DAYS=30 (COMPLIANCE protection cannot be shortened for existing object versions).
# Published dataset manifests stay pinned; the service never overwrites or deletes a version.

